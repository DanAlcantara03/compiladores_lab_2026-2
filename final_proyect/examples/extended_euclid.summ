# Input: a, b
# Output: gcd(a, b), coefficient x and coefficient y
int a = input()
int b = input()

int old_r = a
int r = b
int old_s = 1
int s = 0
int old_t = 0
int t = 1
int q = 0
int tmp = 0
int rem = 0

wh r != 0:
    q = 0
    rem = old_r

    wh rem >= r:
        rem = rem - r
        q = q + 1

    tmp = rem
    old_r = r
    r = tmp

    tmp = old_s - q * s
    old_s = s
    s = tmp

    tmp = old_t - q * t
    old_t = t
    t = tmp

print(old_r)
print(old_s)
print(old_t)
